# =============================================================================
# Axis Global Consultants — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- Database (Neon Postgres) -------------------------------------------------
# Neon dashboard → your project → Connection string (pooled).
# Must include ?sslmode=require
DATABASE_URL=

# --- Email notification (Resend) ---------------------------------------------
# resend.com → API Keys
RESEND_API_KEY=
# Where new-lead alerts are sent
LEAD_NOTIFY_EMAIL=
# Verified sending domain address, e.g. "Axis Global <leads@axisglobalpk.com>"
LEAD_FROM_EMAIL=

# --- WhatsApp Cloud API (Phase 1: off) ---------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Recipient for lead alerts, digits only with country code
WHATSAPP_NOTIFY_TO=

# --- Analytics (optional — omit locally to keep dev clean) --------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://axisglobalpk.com
